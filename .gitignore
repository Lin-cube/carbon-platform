# ════════════════════════════════════════════════════════════════
# 碳能智控运维平台 · .gitignore
#
# 原则：凡是「能由脚本重新生成」或「含本地环境信息/密钥」的内容都不入库。
# ════════════════════════════════════════════════════════════════

# ──────────────────────────────────────── 密钥与环境（最高优先级）
# 注意：必须写 secrets/* 而不是 secrets/，
# 否则整个目录被忽略，目录内的例外规则（!）不会生效（git 的行为）
secrets/*
# 例外：保留配置模板（不含真实密钥），方便他人知道要配哪些变量
!secrets/local.env.example
secrets.env
.env
.env.local
*.env
application-local.yml
backend/src/main/resources/application-local.yml
*-secret.yml
*.pem
*.key
*.p12
*.jks
*.keystore

# ──────────────────────────────────────── 数据库与数据产物
# 数据可由 data-pipeline/scripts 重新生成；.mysql 是项目内独立实例的数据目录（约 8GB）
.mysql/
data/exports/
data/processed/
data/raw/
# 例外：保留演示用小样例（几 KB），方便他人克隆后直接试用导入向导
!data/samples/
!data/samples/*.csv

# 外部知识库语料（约 3MB，按需自行放置；若要一起提交，删除下面这行）
sikong_knowledge_base.txt

# 评测明细（可由 04_eval_anomaly.py 重新生成）
docs/eval/anomaly_eval_detail.csv*

# ──────────────────────────────────────── Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# RAG 索引产物（由 build_index.py 生成，约 29MB，可重建）
rag-service/data/

# ──────────────────────────────────────── Java / Maven
backend/target/
backend/.mvn/
backend/.import-tmp/
*.class

# ──────────────────────────────────────── 前端
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
node_modules/

# ──────────────────────────────────────── 日志与临时文件
.logs/
*.log
*.pid
*.tmp
.DS_Store
Thumbs.db

# ──────────────────────────────────────── IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*~
