[
  {
    "type": "function",
    "function": {
      "name": "getParkEnergySummary",
      "description": "查询某园区在日期范围内的能耗汇总：总用电、空调能耗、碳排放、平均COP、异常小时与峰谷时段。",
      "parameters": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "description": "园区编号，例如 Eagle"
          },
          "startDate": {
            "type": "string",
            "description": "开始日期，YYYY-MM-DD"
          },
          "endDate": {
            "type": "string",
            "description": "结束日期，YYYY-MM-DD"
          }
        },
        "required": [
          "siteId",
          "startDate",
          "endDate"
        ]
      }
    }
  },
