[Unit]
Description=Carbon Platform Backend (Spring Boot 3)
Documentation=https://github.com/Lin-cube/carbon-platform
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=carbon
Group=carbon
WorkingDirectory=/opt/carbon-platform

# 密钥从环境文件读取。
# 注意：systemd 的 EnvironmentFile 不支持 `export` 前缀，
# 部署脚本已自动生成去掉了 export 的版本（secrets/local.env.systemd）。
EnvironmentFile=/opt/carbon-platform/secrets/local.env.systemd

# 堆内存由 secrets/local.env.systemd 里的 CARBON_JAVA_OPTS 控制：
#   4G 机器 → -Xms256m -Xmx768m -XX:MaxMetaspaceSize=256m -XX:+UseG1GC
#   2G 机器 → -Xms256m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC
# 实测本项目默认堆 597MB，压到 384m 仍可正常工作。
# systemd 会展开 $CARBON_JAVA_OPTS（需先用 EnvironmentFile 定义）。
ExecStart=/usr/bin/java $CARBON_JAVA_OPTS \
    -Duser.timezone=Asia/Shanghai \
    -jar /opt/carbon-platform/backend.jar

Restart=always
RestartSec=5
# 启动失败时不要无限重启（比如数据库没起来）
StartLimitIntervalSec=120
StartLimitBurst=5

StandardOutput=append:/opt/carbon-platform/logs/backend.log
StandardError=append:/opt/carbon-platform/logs/backend.err.log

# 基本加固
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
