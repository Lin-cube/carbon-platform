# ══════════════════════════════════════════════════════════════
# 密钥配置模板
#
# 使用方式：
#   cp secrets/local.env.example secrets/local.env
#   然后编辑 secrets/local.env 填入你的真实密钥
#
# 安全说明：
#   · secrets/local.env 已被 .gitignore 忽略，不会进入版本库
#   · 本模板文件（*.example）会被提交，**不要在此写真实密钥**
#   · scripts/start-all.sh 启动时会自动 source 该文件
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────── 大模型（用于 AI 字段映射 + 知识问答生成）
# provider 取值：deepseek | modelscope | dashscope | mock | none
#   deepseek     https://api.deepseek.com                                    model=deepseek-chat
#   modelscope   https://api-inference.modelscope.cn/v1                      model=Qwen/Qwen2.5-72B-Instruct
#   dashscope    https://dashscope.aliyuncs.com/compatible-mode/v1           model=qwen-plus
#   mock         离线演示，不联网（按列名确定性推断，仅用于验证链路）
#   none         不启用大模型（字段映射降级为规则引擎，知识问答返回检索原文）
export CARBON_LLM_PROVIDER=deepseek
export CARBON_LLM_KEY=在此填入你的_API_Key
export CARBON_LLM_BASE=https://api.deepseek.com
export CARBON_LLM_MODEL=deepseek-chat

# 生成答案的输出长度上限。大模型延迟与输出长度近似线性
# （实测 35 token≈1.8s、500 token≈2.1s、644 token≈5.2s），
# 限制长度是为了让响应时间可控（验收指标要求核心接口 P95 ≤ 2s）。
export CARBON_LLM_MAX_TOKENS=500

# ──────────────────────────────────────── AI 问答路由模式
# mock    只走本地统计（数据类问题强，知识类答不了）
# http    全部走外部 AI 服务（知识类强，数据类会失准）
# hybrid  按问题类型路由（推荐）
export CARBON_AI_MODE=hybrid
export CARBON_AI_BASE_URL=http://127.0.0.1:8000

# ──────────────────────────────────────── JWT 签名密钥
# 生产环境务必改成随机长字符串，例如：openssl rand -base64 48
# export CARBON_JWT_SECRET=请替换为随机长字符串

# ──────────────────────────────────────── 数据库账号（本地默认 root 无密码）
# export CARBON_DB_USER=root
# export CARBON_DB_PASSWORD=

# ──────────────────────────────────────── RAG 检索拒答阈值
# 最高相关度低于该值时不调用大模型，直接回答「知识库中未找到」。
# 实测：知识库覆盖的问题得分 2.70~4.00，未覆盖 0.55~2.15，故取 2.5 为分界。
# export CARBON_RAG_MIN_RELEVANCE=2.5

# ──────────────────────────────────────── DeepSeek 官方 API（小E 模型接入）
# 与上面的 CARBON_LLM_KEY 等价；两者都配置时优先使用本变量。
# 切勿把真实密钥写进本模板（本文件会被提交到 GitHub）。
export DEEPSEEK_API_KEY=

# ──────────────────────────────────────── 腾讯元宝搜索（联网搜索，外部资料）
# 元宝搜索「服务 API KEY」方式（sk- 前缀，Bearer 密钥，非 SecretId/SecretKey）。
# 密钥从环境变量读取，前端不持有，代码不硬编码。
export YUANBAO_SEARCH_API_KEY=
export YUANBAO_SEARCH_BASE_URL=https://api.yuanbao.tencent.com
export YUANBAO_SEARCH_MODEL=yuanbao-search
